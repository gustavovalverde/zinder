# Z3 mainnet attachment. Use with:
#
#   docker compose --env-file deploy/.env.mainnet -f deploy/docker-compose.yml up -d
#
# Requires Z3 mainnet to be running first (the `z3-mainnet` external network
# and `z3-mainnet-cookie` external volume must already exist). See:
# https://github.com/ZcashFoundation/z3.
#
# Mainnet uses the canonical (no-offset) host ports from the compose file.
# Testnet adds +10000 (see deploy/.env.testnet); regtest adds +20000.
# Setting them explicitly here documents the canonical port matrix.

Z3_NETWORK_LOWER=mainnet
ZINDER_NETWORK__NAME=zcash-mainnet
ZINDER_NODE__JSON_RPC_ADDR=http://zebra:8232
ZINDER_NODE__INDEXER_GRPC_ADDR=http://zebra:8230

# Host ports for zinder readers + ops endpoints (canonical, no offset).
ZINDER_INGEST_CONTROL_HOST_PORT=9100
ZINDER_INGEST_OPS_HOST_PORT=9105
ZINDER_QUERY_HOST_PORT=9101
ZINDER_QUERY_OPS_HOST_PORT=9106
ZINDER_EXPLORER_HOST_PORT=9068
ZINDER_EXPLORER_OPS_HOST_PORT=9069

# Observability host ports (canonical, no offset).
ZINDER_PROMETHEUS_HOST_PORT=9095
ZINDER_GRAFANA_HOST_PORT=3002
