# Z3 mainnet attachment. Use with:
#
#   docker compose --env-file deploy/.env.mainnet -f deploy/docker-compose.yml up -d
#
# Requires Z3 mainnet to be running first (the `z3-mainnet` external network
# and `z3-mainnet-cookie` external volume must already exist). See:
# https://github.com/ZcashFoundation/z3.

Z3_NETWORK_LOWER=mainnet
ZINDER_NETWORK__NAME=zcash-mainnet
ZINDER_NODE__JSON_RPC_ADDR=http://zebra:8232
ZINDER_NODE__INDEXER_GRPC_ADDR=http://zebra:8230
