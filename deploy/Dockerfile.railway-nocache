# syntax=docker/dockerfile:1.7

# Railway-friendly Zinder runtime image builder without BuildKit cache
# mounts. Mirrors deploy/Dockerfile but drops `--mount=type=cache`
# entirely so this file is portable across Railway service IDs (Railway
# requires literal `s/<service-id>-<cache-name>` prefixes that can't be
# parameterized via ${...}). Used by any new Railway service in the
# zexplorer project. Cold builds are ~5 minutes; Railway's ephemeral builders
# rarely reuse the cache, so the loss is negligible in practice.

ARG RUST_VERSION=1.95
ARG DEBIAN_RELEASE=bookworm
# A deployed Railway service must choose an admitted target explicitly. The
# Railway image is an ingest-only diagnostic or canary runtime, not a
# wallet-serving production topology.
ARG RAILWAY_DOCKER_TARGET_STAGE=zinder-admission-required

FROM rust:${RUST_VERSION}-${DEBIAN_RELEASE} AS zinder-build-base

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        clang \
        cmake \
        libclang-dev \
        pkg-config \
    && rm -rf /var/lib/apt/lists/*

ENV CARGO_TARGET_DIR=/workspace/target
WORKDIR /workspace

# Keep rustup's toolchain/component hydration in a source-independent layer.
# `cargo build` reads rust-toolchain.toml, and if this file is first seen after
# `COPY . .`, every source-change rebuild can pay for component synchronization.
COPY rust-toolchain.toml ./
RUN rustup show active-toolchain >/dev/null

FROM zinder-build-base AS zinder-binaries

ARG RUST_VERSION
ARG TARGETARCH
ARG TARGETVARIANT

# x86-64-v3 also reaches the vendored RocksDB C++ (hardware CRC32c, AVX2);
# scoping to the target triple keeps build scripts and non-x86 images on the
# baseline ISA. Runtime hosts are verified at startup before storage opens.
ENV CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_RUSTFLAGS="-C target-cpu=x86-64-v3 -C target-feature=+pclmulqdq"

COPY . .

RUN cargo build --locked --release \
        --bin zinder-ingest \
    && mkdir -p /zinder-binaries \
    && cp /workspace/target/release/zinder-ingest /zinder-binaries/zinder-ingest

FROM debian:${DEBIAN_RELEASE}-slim AS zinder-runtime-base

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --system --gid 1000 zinder \
    && useradd --system --uid 1000 --gid zinder --home /var/lib/zinder --shell /usr/sbin/nologin zinder \
    && mkdir -p /var/lib/zinder/secondary /etc/zinder \
    && chown -R zinder:zinder /var/lib/zinder /etc/zinder

FROM zinder-runtime-base AS zinder-ingest

COPY --from=zinder-binaries /zinder-binaries/zinder-ingest /usr/local/bin/zinder-ingest

USER zinder:zinder
WORKDIR /var/lib/zinder

ENV ZINDER_OPS__LISTEN_ADDR=[::]:9105
ENV ZINDER_SECURITY__ALLOW_PUBLIC_BIND=true

EXPOSE 9105

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -fsS http://localhost:9105/healthz || exit 1

ENTRYPOINT ["zinder-ingest"]

FROM zinder-ingest AS zinder-canonical-runtime

COPY --chmod=0755 deploy/canonical-runtime-entrypoint \
    /usr/local/bin/zinder-canonical-runtime-entrypoint

# Railway volume mounts replace the ownership baked into the image. Start the
# narrow ownership repair as root; the entrypoint immediately drops to zinder.
USER root:root

ENTRYPOINT ["zinder-canonical-runtime-entrypoint"]

# Railway's final image is structurally fixed to the canonical-only runtime.
# The argument is an admission token, not a dynamic Docker stage selector: the
# closed default fails this build, and naming the mixed bundle cannot change
# the final image or bypass the guard.
FROM zinder-canonical-runtime AS zinder-railway-runtime

ARG RAILWAY_DOCKER_TARGET_STAGE

RUN test "${RAILWAY_DOCKER_TARGET_STAGE}" = "zinder-canonical-runtime" \
    || { echo >&2 "Railway target must be zinder-canonical-runtime"; exit 1; }
