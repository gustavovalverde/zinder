# Z3 testnet attachment. Use with:
#
#   docker compose --env-file deploy/.env.testnet -f deploy/docker-compose.yml up -d
#
# Requires Z3 testnet to be running first (the `z3-testnet` external network
# and `z3-testnet-cookie` external volume must already exist). See:
# https://github.com/ZcashFoundation/z3.
#
# Host ports are offset by +10000 vs the compose mainnet defaults so the two
# zinder flavours coexist on one host (mirrors the convention Zebra itself
# uses, 8232 vs 18232, and the offset z3 applies in .env.testnet).

Z3_NETWORK_LOWER=testnet
ZINDER_NETWORK__NAME=zcash-testnet
ZINDER_NODE__JSON_RPC_ADDR=http://zebra:18232
ZINDER_NODE__INDEXER_GRPC_ADDR=http://zebra:18230

# Host ports for zinder readers + ops endpoints (+10000 offset).
ZINDER_INGEST_CONTROL_HOST_PORT=19100
ZINDER_INGEST_OPS_HOST_PORT=19105
ZINDER_QUERY_HOST_PORT=19101
ZINDER_QUERY_OPS_HOST_PORT=19106
ZINDER_EXPLORER_HOST_PORT=19068
ZINDER_EXPLORER_OPS_HOST_PORT=19069

# Observability host ports (+10000 offset).
ZINDER_PROMETHEUS_HOST_PORT=19095
ZINDER_GRAFANA_HOST_PORT=13002
