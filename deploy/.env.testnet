# Z3 testnet attachment. Use with:
#
#   docker compose --env-file deploy/.env.testnet -f deploy/docker-compose.yml up -d
#
# Requires Z3 testnet to be running first (the `z3-testnet` external network
# and `z3-testnet-cookie` external volume must already exist). See:
# https://github.com/ZcashFoundation/z3.

Z3_NETWORK_LOWER=testnet
ZINDER_NETWORK__NAME=zcash-testnet
ZINDER_NODE__JSON_RPC_ADDR=http://zebra:18232
ZINDER_NODE__INDEXER_GRPC_ADDR=http://zebra:18230
