# Copy this file to a local path, replace the fixture paths, and pass it with
# `docker compose --env-file`. Relative bind paths resolve from deploy/, where
# docker-compose.storage-benchmark.yml lives.

ZINDER_BENCH_PROJECT_NAME=zinder-storage-benchmark

# Required for every Compose operation. Use a local image ID in
# `sha256:<64-hex>` form or a registry reference pinned with `@sha256:<64-hex>`.
# Mutable tags are not accepted by zinder-bench and must not identify evidence.
# ZINDER_BENCH_IMAGE=

# Immutable replay inputs. The starting store tip must be fixture.from_height - 1.
ZINDER_BENCH_FIXTURE_PATH=../fixtures/mainnet-150k-200k
ZINDER_BENCH_START_STORE_PATH=../fixtures/store-149999

# Create this directory before replay and make it writable by container UID 1000.
ZINDER_BENCH_RESULTS_PATH=../benchmark-results

# Required for every Compose replay. Add concrete values to the copied env
# file; the Compose model rejects missing and empty provenance. Use the exact
# tested source revision and the immutable hardware/storage/resource profile.
# Change the runner identity whenever CPU, memory, storage class, resource
# limits, or database settings change, even on the same physical machine.
# ZINDER_BENCH_SOFTWARE_REVISION=
# ZINDER_BENCH_RUNNER_ID=
# ZINDER_BENCH_STORAGE_CLASS=

# Keep these limits constant between candidate runs. Adjust the PostgreSQL GUCs
# below when changing its container memory limit.
ZINDER_BENCH_ROCKSDB_CPUS=8.0
ZINDER_BENCH_ROCKSDB_MEMORY_LIMIT_BYTES=17179869184
ZINDER_BENCH_BLOCK_PREPARE_CONCURRENCY=16
# Optional fixture-specific acceptance pair used only by the full override in
# storage-benchmark.md. The default diagnostic service command has no threshold.
# ZINDER_BENCH_FIXTURE_REPLAY_TARGET_SECS=
# ZINDER_BENCH_FIXTURE_REPLAY_HARD_LIMIT_SECS=
ZINDER_BENCH_POSTGRES_CPUS=8.0
ZINDER_BENCH_POSTGRES_MEMORY_LIMIT_BYTES=17179869184
ZINDER_BENCH_POSTGRES_SHARED_MEMORY_SIZE=2g
ZINDER_BENCH_POSTGRES_TMPFS_SIZE=512m

# Local-only PostgreSQL endpoint and intentionally non-secret credentials.
ZINDER_BENCH_POSTGRES_IMAGE=postgres:18.4-bookworm@sha256:1961f96e6029a02c3812d7cb329a3b03a3ac2bb067058dec17b0f5596aca9296
ZINDER_BENCH_POSTGRES_HOST_PORT=55432
ZINDER_BENCH_POSTGRES_DATABASE=zinder_bench
ZINDER_BENCH_POSTGRES_USER=zinder_bench
ZINDER_BENCH_POSTGRES_PASSWORD=zinder_bench_local_only

# PostgreSQL 18 bulk-build candidate settings. Durability remains enabled.
ZINDER_BENCH_POSTGRES_MAX_CONNECTIONS=50
ZINDER_BENCH_POSTGRES_SHARED_BUFFERS=4GB
ZINDER_BENCH_POSTGRES_EFFECTIVE_CACHE_SIZE=12GB
ZINDER_BENCH_POSTGRES_MAINTENANCE_WORK_MEM=2GB
ZINDER_BENCH_POSTGRES_WORK_MEM=64MB
ZINDER_BENCH_POSTGRES_MAX_WAL_SIZE=16GB
ZINDER_BENCH_POSTGRES_MIN_WAL_SIZE=2GB
ZINDER_BENCH_POSTGRES_CHECKPOINT_TIMEOUT=15min
ZINDER_BENCH_POSTGRES_CHECKPOINT_COMPLETION_TARGET=0.9
ZINDER_BENCH_POSTGRES_WAL_COMPRESSION=on
ZINDER_BENCH_POSTGRES_MAX_WORKER_PROCESSES=8
ZINDER_BENCH_POSTGRES_MAX_PARALLEL_WORKERS=8
ZINDER_BENCH_POSTGRES_MAX_PARALLEL_MAINTENANCE_WORKERS=4
