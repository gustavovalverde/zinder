#!/command/with-contenv sh
#
# Supervises the in-container nginx multiplexer (h2c on :9099) that
# routes gRPC requests by `:path` prefix to either zinder-query (9101)
# or zinder-explorer (9068). PaaS targets that cap a service at one TCP
# proxy and can't terminate HTTPS-to-h2c on their HTTP edge use this
# multiplexer to expose both planes through a single external port.
#
# Waits for both readers to accept loopback connections before starting
# nginx, so the first request never gets a 502 because the upstream is
# still booting.

set -eu

# Operator-set escape hatch for from-genesis rebuilds: query and explorer
# park under the same flag, so waiting on their ports here would block
# forever. ZREBUILD_READERS is deliberately not ZINDER_-prefixed so it
# never reaches the strict config loader.
if [ "${ZREBUILD_READERS:-}" = "off" ]; then
    echo "zinder-multiplexer/run: ZREBUILD_READERS=off; parking the multiplexer instead of starting nginx" >&2
    exec sleep infinity
fi

QUERY_HOST=127.0.0.1
QUERY_PORT=9101
EXPLORER_HOST=127.0.0.1
EXPLORER_PORT=9068
WAIT_DEADLINE_SECONDS=600
WAIT_INTERVAL_SECONDS=2

wait_for_port() {
    host="$1"
    port="$2"
    name="$3"
    elapsed=0
    until nc -z "$host" "$port"; do
        if [ "$elapsed" -ge "$WAIT_DEADLINE_SECONDS" ]; then
            echo "zinder-multiplexer/run: ${name} endpoint at ${host}:${port} did not accept connections within ${WAIT_DEADLINE_SECONDS}s; exiting so s6 can decide whether to retry or tear down." >&2
            exit 1
        fi
        sleep "$WAIT_INTERVAL_SECONDS"
        elapsed=$((elapsed + WAIT_INTERVAL_SECONDS))
    done
}

wait_for_port "$QUERY_HOST" "$QUERY_PORT" zinder-query
wait_for_port "$EXPLORER_HOST" "$EXPLORER_PORT" zinder-explorer

exec nginx -c /etc/nginx/nginx.conf -g 'daemon off;'
