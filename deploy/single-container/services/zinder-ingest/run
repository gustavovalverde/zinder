#!/command/with-contenv sh
#
# Supervises zinder-ingest inside the single-container image. s6 invokes
# this script and treats stdout/stderr as the service log; the tracing
# subscriber installed by zinder-ingest writes structured events directly
# to stderr, so no log-shipping fan-out is required.

set -eu

# Volume mounts on PaaS targets (Railway, Fly.io, Render) are bound onto
# `/var/lib/zinder` after the image's own filesystem is materialized, and
# the bind-mount root is owned by `root:root` regardless of what the image
# baked. The zinder user (UID 1000) cannot create the RocksDB column-family
# files under that ownership, so RocksDB::open fails with "storage is
# unavailable". Repair ownership on every boot; the operation is a cheap
# metadata-only chown on the volume's top-level entries and idempotent
# across restarts.
chown -R zinder:zinder /var/lib/zinder

INGEST_CONFIG=/etc/zinder/ingest.toml
STORE_PATH=/var/lib/zinder/store
BOOTSTRAP_REORG_HEADROOM_BLOCKS=200

# Tip-follow commits one block per poll iteration, so syncing a fresh
# store from genesis on a mature network takes weeks. The `backfill`
# subcommand batches up to `commit_batch_blocks` blocks per epoch and
# closes that gap in minutes-to-hours. Detect an uninitialized store
# (no RocksDB CURRENT marker) and bootstrap it via wallet-serving
# backfill before handing off to tip-follow. Operators that prefer
# full historical coverage can set `ZINDER_BOOTSTRAP_DISABLED=1`.
if [ ! -f "${STORE_PATH}/CURRENT" ] \
        && [ -z "${ZINDER_BOOTSTRAP_DISABLED:-}" ] \
        && [ -n "${ZINDER_NODE__JSON_RPC_ADDR:-}" ] \
        && [ -n "${ZINDER_NODE__AUTH__COOKIE:-}" ]; then
    node_tip=$(curl -sS --connect-timeout 10 --max-time 15 \
        -u "${ZINDER_NODE__AUTH__COOKIE}" \
        -H 'content-type: application/json' \
        -d '{"jsonrpc":"1.0","id":"bootstrap","method":"getblockcount","params":[]}' \
        "${ZINDER_NODE__JSON_RPC_ADDR}" \
        | sed -n 's/.*"result":\([0-9][0-9]*\).*/\1/p')

    if echo "${node_tip}" | grep -Eq '^[0-9]+$' \
            && [ "${node_tip}" -gt "${BOOTSTRAP_REORG_HEADROOM_BLOCKS}" ]; then
        bootstrap_to_height=$((node_tip - BOOTSTRAP_REORG_HEADROOM_BLOCKS))
        printf 'zinder-ingest/run: bootstrapping empty store via wallet-serving backfill (node_tip=%s to_height=%s)\n' \
            "${node_tip}" "${bootstrap_to_height}" >&2
        s6-setuidgid zinder \
            /usr/local/bin/zinder-ingest backfill \
            --config "${INGEST_CONFIG}" \
            --wallet-serving \
            --to-height "${bootstrap_to_height}" \
            || printf 'zinder-ingest/run: backfill exited non-zero; continuing to tip-follow so the supervisor can surface the error\n' >&2
    else
        printf 'zinder-ingest/run: skipping bootstrap (node_tip=%s); tip-follow will sync from genesis\n' \
            "${node_tip:-<empty>}" >&2
    fi
fi

# Run as the unprivileged zinder user. s6-overlay's s6-setuidgid is the
# idiomatic way to drop privileges inside a longrun script.
#
# Each Zinder binary strict-parses its own TOML schema (writer and reader
# do not share the same field set), so the single-container image ships
# two configs: `/etc/zinder/ingest.toml` for the writer and
# `/etc/zinder/query.toml` for the reader.
exec s6-setuidgid zinder \
    /usr/local/bin/zinder-ingest tip-follow \
    --config "${INGEST_CONFIG}" \
    --ops-listen-addr 127.0.0.1:9105
