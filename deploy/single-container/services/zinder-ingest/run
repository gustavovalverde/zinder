#!/command/with-contenv sh
#
# Supervises zinder-ingest inside the single-container image. s6 invokes
# this script and treats stdout/stderr as the service log; the tracing
# subscriber installed by zinder-ingest writes structured events directly
# to stderr, so no log-shipping fan-out is required.

set -eu

# Volume mounts on PaaS targets (Railway, Fly.io, Render) are bound onto
# `/var/lib/zinder` after the image's own filesystem is materialized, and
# the bind-mount root is owned by `root:root` regardless of what the image
# baked. The zinder user (UID 1000) cannot create the RocksDB column-family
# files under that ownership, so RocksDB::open fails with "storage is
# unavailable". Repair ownership on every boot; the operation is a cheap
# metadata-only chown on the volume's top-level entries and idempotent
# across restarts.
chown -R zinder:zinder /var/lib/zinder

# Opt-in destructive recovery for PaaS hosts that leak orphan OFD locks
# onto the RocksDB primary's LOCK inode (Railway has been observed
# leaving an OFDLCK entry in /proc/locks with PID -1 that survives
# container restart and forces every fresh ingest to fail with "primary
# store is already open"). When set, archive the old store/secondary
# directories to a timestamped sibling and start fresh; zinder will
# resync from genesis. Operators MUST unset this env var after the first
# successful boot so subsequent restarts don't wipe live data.
if [ -n "${ZINDER_WIPE_PRIMARY_ON_BOOT:-}" ]; then
    ts=$(date +%s)
    echo "zinder-ingest/run: ZINDER_WIPE_PRIMARY_ON_BOOT set; archiving store to /var/lib/zinder/store.archived-${ts}" >&2
    [ -d /var/lib/zinder/store ] && mv /var/lib/zinder/store "/var/lib/zinder/store.archived-${ts}" || true
    [ -d /var/lib/zinder/secondary ] && mv /var/lib/zinder/secondary "/var/lib/zinder/secondary.archived-${ts}" || true
    [ -d /var/lib/zinder/explorer-secondary ] && mv /var/lib/zinder/explorer-secondary "/var/lib/zinder/explorer-secondary.archived-${ts}" || true
fi

# Remove a stale RocksDB primary LOCK file left by an unclean shutdown.
# Safe in this single-container image because exactly one writer ever
# runs in this PID namespace. RocksDB clears stale POSIX locks only when
# the previous holder ran on the same kernel, so PaaS targets that
# reschedule containers across hosts trip on the staleness check.
mkdir -p /var/lib/zinder/store
chown zinder:zinder /var/lib/zinder/store
rm -f /var/lib/zinder/store/LOCK

# Unified ingest loop per ADR-0015. The single process classifies the
# gap to the upstream tip on every iteration and dispatches to
# AwaitingUpstream / BulkCatchup / FollowingTip; no separate bootstrap
# pass is needed.
exec s6-setuidgid zinder \
    /usr/local/bin/zinder-ingest \
    --config /etc/zinder/ingest.toml \
    --ops-listen-addr 127.0.0.1:9105
