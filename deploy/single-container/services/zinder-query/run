#!/command/with-contenv sh
#
# Supervises zinder-query inside the single-container image.
#
# Depends on zinder-ingest being up: the dependency is declared in
# dependencies.d/, but s6's "started" means "run script invoked", not
# "ready to serve". The reader opens a `RocksDB` secondary against the
# writer's primary, which fails until the writer has created its column
# families. Wait here until the writer's IngestControl endpoint accepts
# TCP connections (the writer binds it once its primary store is open),
# then launch the binary.

set -eu

INGEST_CONTROL_HOST=127.0.0.1
INGEST_CONTROL_PORT=9100
# Cold-boot startup (store open, schema validation, optional recovery)
# completes before the ingest-control endpoint accepts traffic. The 600s
# deadline covers the worst-case bootstrap on a freshly cloned store from
# any height on testnet without timing out on healthy nodes.
WAIT_DEADLINE_SECONDS=600
WAIT_INTERVAL_SECONDS=2

elapsed=0
until nc -z "$INGEST_CONTROL_HOST" "$INGEST_CONTROL_PORT"; do
    if [ "$elapsed" -ge "$WAIT_DEADLINE_SECONDS" ]; then
        echo "zinder-query/run: ingest-control endpoint at ${INGEST_CONTROL_HOST}:${INGEST_CONTROL_PORT} did not accept connections within ${WAIT_DEADLINE_SECONDS}s; exiting so s6 can decide whether to retry or tear down." >&2
        exit 1
    fi
    sleep "$WAIT_INTERVAL_SECONDS"
    elapsed=$((elapsed + WAIT_INTERVAL_SECONDS))
done

# Strip env vars whose TOML section the query schema doesn't allow.
# The single-container image shares one process env across all three
# supervised binaries; query's schema permits [network], [node],
# [storage], [ingest_control], [query], [retention], [ops]. Strip:
#  - ZINDER_INGEST__*  (writer-only catchup tunables)
#  - ZINDER_EXPLORER__* (explorer binary's listen-addr lives in this
#    namespace; query also has an [explorer] proxy section with
#    `endpoint`/`bearer_token_path`/`probe_interval_ms` but no
#    `listen_addr`, so the explorer binary's env vars would be
#    rejected as unknown fields within the [explorer] section).
#  - ZINDER_INGEST_CONTROL__LISTEN_ADDR (ingest's writer-binding addr;
#    query's [ingest_control] only has `addr` for the reader-side
#    target endpoint, so `listen_addr` is an unknown field here).
unset $(env | sed -n -e 's/^\(ZINDER_INGEST__[^=]*\)=.*/\1/p' \
                     -e 's/^\(ZINDER_EXPLORER__[^=]*\)=.*/\1/p' \
                     -e 's/^\(ZINDER_INGEST_CONTROL__LISTEN_ADDR\)=.*/\1/p') 2>/dev/null || true

# Shell-only ingest recovery knob shared through the container env; no
# binary schema recognizes it, so drop it before exec to avoid crashing
# load_config.
unset ZINDER_WIPE_PRIMARY_ON_BOOT

exec s6-setuidgid zinder \
    /usr/local/bin/zinder-query \
    --ops-listen-addr [::]:9106
