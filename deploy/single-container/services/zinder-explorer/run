#!/command/with-contenv sh
#
# Supervises zinder-explorer inside the single-container image.
#
# Like zinder-query, the explorer plane opens a RocksDB secondary against
# the writer's primary store and therefore can only start once the writer
# has materialized its column families. The dependency is declared in
# dependencies.d/, but s6's "started" only means "run script invoked";
# wait until the writer's IngestControl endpoint binds (it binds once the
# primary store is open) before launching the binary.

set -eu

# Operator-set escape hatch for from-genesis rebuilds: the reader plane
# serves nothing useful while ingest is still bulk-catching-up, but its
# RocksDB secondary still holds block cache and replay threads inside the
# shared cgroup. ZREBUILD_READERS is deliberately not ZINDER_-prefixed so
# it never reaches the strict config loader.
if [ "${ZREBUILD_READERS:-}" = "off" ]; then
    echo "zinder-explorer/run: ZREBUILD_READERS=off; parking the reader plane instead of starting zinder-explorer" >&2
    exec sleep infinity
fi

INGEST_CONTROL_HOST=127.0.0.1
INGEST_CONTROL_PORT=9100
WAIT_DEADLINE_SECONDS=600
WAIT_INTERVAL_SECONDS=2

elapsed=0
until nc -z "$INGEST_CONTROL_HOST" "$INGEST_CONTROL_PORT"; do
    if [ "$elapsed" -ge "$WAIT_DEADLINE_SECONDS" ]; then
        echo "zinder-explorer/run: ingest-control endpoint at ${INGEST_CONTROL_HOST}:${INGEST_CONTROL_PORT} did not accept connections within ${WAIT_DEADLINE_SECONDS}s; exiting so s6 can decide whether to retry or tear down." >&2
        exit 1
    fi
    sleep "$WAIT_INTERVAL_SECONDS"
    elapsed=$((elapsed + WAIT_INTERVAL_SECONDS))
done

# Strip env vars whose TOML section the explorer schema doesn't allow.
# The single-container image shares one process env across all three
# supervised binaries; explorer's schema accepts [network], [storage],
# [explorer], [ops], and [node]. The [node] section is read-only on the
# explorer side: it feeds the optional upstream-observation probe that
# populates ExplorerFreshness.upstream so consumers can render honest
# sync-progress UI. Without it, the probe never spawns and every
# response's `upstream` field stays unset. Strip the remaining
# writer-only prefixes:
#  - ZINDER_INGEST__*         (writer-only catchup tunables)
#  - ZINDER_QUERY__*          (wallet-query's listen-addr and
#                              ingest_control settings; explorer has no
#                              [query] section)
#  - ZINDER_INGEST_CONTROL__* (writer-binding only)
unset $(env | sed -n -e 's/^\(ZINDER_INGEST__[^=]*\)=.*/\1/p' \
                     -e 's/^\(ZINDER_INGEST_CONTROL__[^=]*\)=.*/\1/p' \
                     -e 's/^\(ZINDER_QUERY__[^=]*\)=.*/\1/p') 2>/dev/null || true

# Shell-only ingest recovery knob shared through the container env; no
# binary schema recognizes it, so drop it before exec to avoid crashing
# load_config.
unset ZINDER_WIPE_PRIMARY_ON_BOOT

# Default the wallet-query endpoint to the bundled wallet-query plane.
# The single-container image runs zinder-query on localhost:9101; the
# explorer must point at it for `advertised_capabilities()` to emit
# anything beyond `explorer.server_info_v1`. Without this default the
# explorer at-tip silently advertises an empty capability set and every
# read returns `capability_unavailable`. Operators can still override
# with a non-localhost endpoint by setting the env var externally; the
# `:-` form only defaults if it's unset.
export ZINDER_EXPLORER__WALLET_QUERY_ENDPOINT="${ZINDER_EXPLORER__WALLET_QUERY_ENDPOINT:-http://127.0.0.1:9101}"

exec s6-setuidgid zinder \
    /usr/local/bin/zinder-explorer \
    --ops-listen-addr [::]:9069
