# Z3 regtest attachment. Use with:
#
#   docker compose --env-file deploy/.env.regtest -f deploy/docker-compose.yml up -d
#
# Requires Z3 regtest to be running first (the `z3-regtest` external network
# and `z3-regtest-cookie` external volume must already exist). See:
# https://github.com/ZcashFoundation/z3.
#
# Z3 regtest disables Zebra's cookie auth (the regtest Zebra accepts
# unauthenticated requests from inside the Docker network), so this helper
# overrides ZINDER_NODE__AUTH__METHOD to `none`. The cookie volume mount
# stays in the compose file; it is just not consulted at this auth method.
#
# Host ports are offset by +20000 vs the compose mainnet defaults so the
# regtest flavour coexists with mainnet (no offset) and testnet (+10000).

Z3_NETWORK_LOWER=regtest
ZINDER_NETWORK__NAME=zcash-regtest
ZINDER_NODE__JSON_RPC_ADDR=http://zebra:18232
ZINDER_NODE__INDEXER_GRPC_ADDR=http://zebra:18230
ZINDER_NODE__AUTH__METHOD=none

# Host ports for zinder readers + ops endpoints (+20000 offset).
ZINDER_INGEST_CONTROL_HOST_PORT=29100
ZINDER_INGEST_OPS_HOST_PORT=29105
ZINDER_QUERY_HOST_PORT=29101
ZINDER_QUERY_OPS_HOST_PORT=29106
ZINDER_EXPLORER_HOST_PORT=29068
ZINDER_EXPLORER_OPS_HOST_PORT=29069

# Observability host ports (+20000 offset).
ZINDER_PROMETHEUS_HOST_PORT=29095
ZINDER_GRAFANA_HOST_PORT=23002
